{
  "name": "voxro-video",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "capture": "node scripts/capture.mjs && node scripts/encode.mjs",
    "vo": "node scripts/voiceover.mjs && node scripts/timing.mjs",
    "music": "node scripts/music.mjs",
    "sfx": "node scripts/sfx.mjs",
    "stills": "node scripts/stills.mjs",
    "draft": "remotion render src/index.ts Teaser out/draft.mp4 --scale 0.5 --crf 20 --concurrency 10",
    "render4k": "remotion render src/index.ts Teaser out/voxro-teaser-4k-raw.mp4 --scale 2 --image-format jpeg --jpeg-quality 95 --codec h264 --crf 14 --x264-preset medium --pixel-format yuv420p --audio-codec aac --audio-bitrate 320k --concurrency 12",
    "finish": "node scripts/finish.mjs out/voxro-teaser-4k-raw.mp4 out/voxro-teaser-4k.mp4",
    "poster": "remotion still src/index.ts Poster out/voxro-teaser-thumbnail.png"
  },
  "dependencies": {
    "@remotion/cli": "4.0.530",
    "@remotion/google-fonts": "4.0.530",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.530"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.530",
    "@remotion/renderer": "4.0.530",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.6.0"
  }
}
